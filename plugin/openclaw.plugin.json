{
  "id": "cpp-channel",
  "name": "C++ Channel",
  "description": "Unix Socket channel for C++ Native service integration with HTTP injection",
  "channels": ["cpp-channel"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "socketPath": {
        "type": "string",
        "default": "/tmp/openclaw.sock",
        "description": "Unix socket path for C++ client connection"
      },
      "httpPort": {
        "type": "number",
        "default": 18999,
        "description": "HTTP port for message injection API"
      },
      "gatewayUrl": {
        "type": "string",
        "default": "http://127.0.0.1:18789",
        "description": "OpenClaw Gateway URL for agent message injection"
      },
      "accounts": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true }
          }
        }
      }
    }
  },
  "uiHints": {
    "socketPath": {
      "label": "Socket Path",
      "placeholder": "/tmp/openclaw.sock"
    },
    "httpPort": {
      "label": "HTTP Port",
      "placeholder": "18999"
    },
    "gatewayUrl": {
      "label": "Gateway URL",
      "placeholder": "http://127.0.0.1:18789"
    }
  }
}