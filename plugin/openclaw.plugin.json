{
  "id": "cpp-channel",
  "name": "C++ Channel",
  "description": "Unix Socket channel for C++ Native service integration",
  "channels": ["cpp-channel"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "socketPath": {
        "type": "string",
        "default": "/tmp/openclaw.sock",
        "description": "Unix socket path for C++ client connection"
      },
      "accounts": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true }
          }
        }
      }
    }
  },
  "uiHints": {
    "socketPath": {
      "label": "Socket Path",
      "placeholder": "/tmp/openclaw.sock"
    }
  }
}